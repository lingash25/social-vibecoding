{
  "name": "usernode-social-vibecoding",
  "version": "1.0.0",
  "private": true,
  "description": "Where the users are the developers are the users are the developers...",
  "main": "server.js",
  "bin": {
    "social-vibecoding": "tools/social-vibecoding"
  },
  "scripts": {
    "prestart": "node scripts/build-schema.js && node scripts/ensure-shell-artifacts.js --runtime",
    "start": "node server.js",
    "predev": "node scripts/build-schema.js && node scripts/ensure-shell-artifacts.js --runtime",
    "dev": "node --watch server.js",
    "pretest": "node scripts/build-schema.js && node scripts/ensure-shell-artifacts.js --html-only",
    "test": "node --require ./tests/lib/test-net.js --test --test-force-exit --test-timeout=180000 tests/*.test.js",
    "test:shard": "node scripts/test-shard.js",
    "test:durations": "node scripts/test-durations.js",
    "pretest:changed": "node scripts/build-schema.js && node scripts/ensure-shell-artifacts.js --html-only",
    "test:changed": "node scripts/test-changed.js",
    "shots:dry-run": "node scripts/shots-dry-run.js",
    "shots:pair": "node scripts/shots-dry-run-pair.js",
    "test:shell-upgrade:browser": "node scripts/verify-shell-upgrade.js",
    "ensure:shell": "node scripts/ensure-shell-artifacts.js --runtime",
    "migrate:kubernetes": "node scripts/migrate-kubernetes.js",
    "cutover:native-delegation": "node scripts/cutover-native-delegation.js",
    "build:css": "node scripts/build-tailwind.js",
    "watch:css": "node scripts/build-tailwind.js --watch",
    "vendor:assets": "node scripts/vendor-assets.js",
    "build:shell": "node frontend/scripts/build-shell.mjs",
    "lint:sql": "node scripts/check-sql.js",
    "check:types": "tsc -p tsconfig.server.json",
    "build:schema": "node scripts/build-schema.js",
    "audit:layout": "node scripts/layout-audit/run.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "dompurify": "3.4.17",
    "marked": "15.0.12",
    "mermaid": "11.17.2",
    "postgres": "3.4.9",
    "qrcodejs": "1.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@kubernetes/client-node": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@octokit/app": "^15.1.2",
    "@octokit/rest": "^22.0.1",
    "bcrypt": "^5.1.1",
    "bech32": "^2.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.3.2",
    "firebase-admin": "^13.10.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "negotiator": "1.0.0",
    "pg": "^8.13.0",
    "pngjs": "7.0.0",
    "rrweb": "2.1.3",
    "undici": "6.29.1",
    "ws": "^8.18.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.7",
    "@mapbox/node-pre-gyp": {
      "tar": "7.5.22"
    }
  }
}
