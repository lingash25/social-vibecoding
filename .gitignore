# No trailing slash: `node_modules/` matches only a DIRECTORY, so a
# symlink named node_modules is not ignored — and one was committed that
# way (#2694), pointing at an absolute path on the machine that made it.
# Every checkout then materialized a dangling link where the install
# belongs, which breaks the shell build until somebody deletes it.
node_modules
/public/index.html
/public/css/tailwind.css
/public/shell/assets/
/public/shell/release.json
/public/shell/worker.js
# The layout audit's report and screenshots (npm run audit:layout).
/layout-audit-report/
.env
# Host-managed deployment state; in particular, never stage the CNPG secret.
runtime/cnpg-replication.env*
*.log
data/
.DS_Store
*.swp
*.swo
*~
*.pem

# Local hackathon data dump (sensitive community PII — do not commit)
hackathon-data/
.playwright-mcp/
# Generated browser captures; selected PR images live in docs/reviews/.
/artifacts/mobile-density/
.superpowers/

# Machine-local Codex MCP wiring (absolute checkout/runtime paths).
.codex/config.toml
.codex/config.toml.lock
.codex/config.toml.lock.*
.codex/.config.toml.tmp-*

# Machine-local Claude Code MCP wiring ownership (configuration is local scope).
.claude/social-vibecoding-mcp.local.json
.claude/social-vibecoding-mcp.local.json.lock
.claude/social-vibecoding-mcp.local.json.lock.*
.claude/.social-vibecoding-mcp.local.json.tmp-*

# Local Claude Code worktree checkouts (never repo content).
.claude/worktrees/

# Machine-local OpenCode MCP wiring (absolute checkout/runtime paths).
.opencode/opencode.jsonc
.opencode/opencode.jsonc.lock
.opencode/opencode.jsonc.lock.*
.opencode/.opencode.jsonc.tmp-*

# Scratch renders. A coding agent checking a layout writes a throwaway page
# or screenshot beside the source, and one of those (a 274KB `__r6.png`) was
# swept into a proposal by a `git add -A` and merged. The double underscore
# is the convention for those files; this makes the mistake unrepeatable
# rather than something the next author has to remember not to make.
__*.png
__*.html
public/__*.html

# Local before/after shots dry runs (scripts/shots-dry-run.js)
.shots-dry-run/

# Rebuilt by each image after shell/CSS generation.
public.precompressed/

# Language packs and the bundled catalog, built from frontend/locales
# (scripts/language-packs.js)
public/locales/
frontend/src/lib/i18n/catalogs.generated.json

/security-reports/

# Generated from the migration history and reference seeds.
src/db/schema.sql
